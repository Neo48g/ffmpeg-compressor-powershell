@echo off
:: Заголовок окна
title Установка FFmpeg

echo ========================================
echo        Запуск установки FFmpeg...
echo ========================================
echo.

:: Запускает PowerShell скрипт, лежащий в той же папке, что и этот батник
:: %~dp0 - это переменная, означающая "путь к папке, где лежит текущий батник"
:: -ExecutionPolicy Bypass - разрешает запуск скриптов, игнорируя системные запреты
:: -NoProfile - ускоряет запуск, не загружая лишние настройки пользователя
powershell.exe -NoProfile -ExecutionPolicy Bypass -File "%~dp0install_ffmpeg.ps1"

:: Если по какой-то причине скрипт завершился с ошибкой и не дошел до своей паузы,
:: оставляет окно открытым чтобы пользователь увидел ошибку.
if %errorlevel% neq 0 (
    echo.
    echo ========================================
    echo            Ошибка установки
    echo ========================================
    pause
)